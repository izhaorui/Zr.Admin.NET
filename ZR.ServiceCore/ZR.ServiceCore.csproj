<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591;1570</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZR.Common\ZR.Common.csproj" />
		<ProjectReference Include="..\ZR.Repository\ZR.Repository.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- WebAuthn / Passkey 校验。选 fido2-net-lib 而非 ASP.NET Identity 内置能力：
		     本项目是自研认证（不走 Identity），且需要按现有 2FA 流程接入，Identity 的 passkey 用不上。
		     版本写死便于复现；升级前请回归注册/认证两条主链路（4.x 起核心方法改为 *Params 参数对象）。 -->
		<PackageReference Include="Fido2" Version="4.3.1" />
		<PackageReference Include="NLog" Version="6.2.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- 第三方授权聚合库（团队自行维护并发布，命名空间 Come.CollectiveOAuth）。
		     只承接标准 OAuth2 网页授权；钉钉（上游为已废弃的旧协议且整段注释）与微信小程序（code2session）
		     由本项目自行实现，见 OAuth/Providers。
		     注意：包内 AlipaySDKNet.Standard 标了 PrivateAssets=all，启用支付宝登录时需在此显式再引一次。 -->
		<PackageReference Include="CollectiveOAuthCore" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  主库公共参考数据种子（省市区三级字典，约 3400 条 / 432KB）。
		  由 MainDbReferenceSeed.EnsureAreas 在 initdb 初始化时灌入主库 sys_area。

		  为什么放 ZR.ServiceCore 而不是业务模块：主库数据的灌入不能依赖业务模块开关，
		  否则模块一关就会留下一张永远空的表（结构由 Migrate 无条件建、数据却没人灌）。
		  详见 MainDbReferenceSeed 的类注释。

		  用 EmbeddedResource 而非 CopyToOutputDirectory：宿主有 Admin.WebApi / Front.WebApi / Tasks，
		  输出目录与 ContentRoot 各不相同，靠相对路径找文件会在某个宿主下失效。
		  LogicalName 固定，避免命名变化导致 GetManifestResourceStream 取不到。
		-->
		<EmbeddedResource Include="SqlSeed\area-seed.json" LogicalName="ZR.ServiceCore.SqlSeed.area-seed.json" />
	</ItemGroup>

</Project>
