<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591;1570</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZR.Common\ZR.Common.csproj" />
		<ProjectReference Include="..\ZR.Repository\ZR.Repository.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- S3 兼容对象存储（RustFS / MinIO / Ceph 等）：用 AWSSDK 的 S3 客户端，见 Oss/S3CompatibleOssProvider.cs。
		     版本写死便于复现；升级时请注意 SDK v4 的破坏性变更（checksum / 签名默认行为）需要回归验证。 -->
		<PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
		<PackageReference Include="NETCore.Encrypt" Version="2.1.1" />
		<PackageReference Include="NLog" Version="6.0.4" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="SKIT.FlurlHttpClient.Wechat.TenpayV3" Version="3.16.0" />
	</ItemGroup>

</Project>
