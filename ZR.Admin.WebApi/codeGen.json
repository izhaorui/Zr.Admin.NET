{
  // 代码生成配置（完整默认值；appsettings.json 不再重复定义，环境覆盖见 appsettings.{Environment}.json）
  // 注：本文件在 Program.cs 中于 UserSecrets / 环境变量之前加载，故可用环境变量 CodeGen__xxx 覆盖。
  "CodeGen": {
    //uniapp 版本号2/3(vue版本号)
    "uniappVersion": 3,
    //是否显示移动端代码生成
    "showApp": false,
    //自动去除表前缀
    "autoPre": true,
    //默认生成业务模块名
    "moduleName": "business",
    "author": "admin",
    "tablePrefix": "sys_", //表前缀（生成类名不会包含表前缀，多个用逗号分隔）
    "vuePath": "", //前端代码存储路径，空默认本项目
    "uniappPath": "", //h5前端代码存储路径
    //数据库字段类型 -> C# 类型映射
    "csharpTypeArr": {
      "string": [ "varchar", "nvarchar", "text", "longtext" ],
      "int": [ "int", "integer", "smallint", "int4", "int8", "int2" ],
      "long": [ "bigint", "number" ],
      "float": [ "numeric", "real", "float" ],
      "decimal": [ "money", "decimal", "smallmoney" ],
      "dateTime": [ "date", "datetime", "datetime2", "smalldatetime", "timestamp" ],
      "byte": [ "tinyint" ],
      "bool": [ "bit" ]
    }
  }
}
