{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "LogLevel": {
        "Microsoft.*": "None"
      }
    }
  },
  // 数据源：系统库 ConfigId 固定 "0"，租户库与 sys_tenant.TenantId 一致；凭据注入见《配置文件》
  "dbConfigs": [
    {
      "Conn": "Data Source=(localdb)\\MSSQLLocalDB;User ID={替换你的账号};Password={替换你的密码};Initial Catalog=ZrAdmin;Encrypt=True;TrustServerCertificate=True;",
      "DbType": 1, //MySql=0, SqlServer=1, Oracle=3, PgSql=4
      "ConfigId": "0",
      "IsAutoCloseConnection": true
    }
    //...更多数据源（租户库）
  ],
  "CodeGenDbConfig": {
    "Conn": "Data Source=(localdb)\\MSSQLLocalDB;User ID={替换你的账号};Password={替换你的密码};Initial Catalog={dbName};Encrypt=True;TrustServerCertificate=True;", //{dbName} 为占位符，不要写具体库名
    "DbType": 1,
    "IsAutoCloseConnection": true,
    "DbName": "ZrAdmin" //代码生成默认连接数据库
  },
  "urls": "http://localhost:8888", //项目启动地址（端口改动需同步前端 devServer）
  // 密钥环加密证书：留空时 Windows 用 DPAPI、Linux 明文落盘并告警；生成命令见《配置文件》
  "DataProtection": {
    "CertificatePath": "", //含私钥的 PFX 路径（绝对路径或相对内容根目录）
    "CertificatePassword": "" //PFX 口令，建议用环境变量 DataProtection__CertificatePassword
  },
  // 微信支付V3：本宿主用于租户续费，商城下单与回调在公网宿主；两者须同一商户号、NotifyUrl 指向公网宿主
  "WechatPay": {
    "Enabled": false,
    "MerchantId": "", //商户号 mchid
    "AppId": "", //绑定的公众号/应用 AppId
    "MerchantCertificateSerialNumber": "", //商户API证书序列号
    "MerchantCertificatePrivateKey": "", //商户API私钥（PEM）
    "MerchantV3Key": "", //APIv3 密钥（回调解密）
    "WechatPayPublicKeyId": "", //微信支付公钥ID（PUB_KEY_ID_xxx）
    "WechatPayPublicKey": "", //微信支付公钥（PEM，回调验签）
    "MiniProgramAppId": "", //小程序 AppId（不填则复用 AppId）
    "MiniProgramSecret": "", //小程序 Secret（code 换 OpenId）
    "NotifyUrl": "https://your-front-domain.com/shopping/front/order/wechat/notify", //支付回调（公网 HTTPS，指向公网宿主）
    "MockNotifyUrl": "", //【仅Development】MockNotify 自调用；留空回退 NotifyUrl
    "H5ReturnUrl": "https://your-front-domain.com" //商城 H5 支付回跳地址
  },
  "corsUrls": [ "http://localhost:8887", "http://localhost:8886" ], //跨域地址（后台前端 + 商城 H5），多个用","隔开
  // 后台管理令牌：SecretKey 须 ≥32 字符且禁止明文提交，用环境变量 JwtSettings__SecretKey 注入；两宿主必须不同
  "JwtSettings": {
    "Issuer": "ZRAdmin.NET", //token 签发者
    "Audience": "ZRAdmin.NET", //token 使用方
    "SecretKey": "",
    "Expire": 1440, //登录过期时间（分）
    "RefreshTokenTime": 30, //剩余有效期小于该分钟数时自动续期
    "MaxLifetime": 10080, //会话绝对上限（分），续期不能突破；0=不限，须 >= Expire
    "TokenType": "Bearer"
  },
  // 双因子认证（TOTP + Passkey）：全部可缺省；WebAuthn 必须配 Origins 且站点为 HTTPS
  "TwoFactor": {
    "Issuer": "ZRAdmin", //认证器 App 中显示的发行方
    "TrustDeviceDays": 7, //“记住此设备”的信任天数
    "WebAuthnEnabled": false, //Passkey 开关：仅当 Origins 配好且为 HTTPS 才生效
    "WebAuthnOrigins": [], //例：[ "https://admin.your-domain.com" ]
    "WebAuthnRpId": "", //留空取 Origins 首项域名，多子域建议配根域名
    "WebAuthnRpName": "ZRAdmin",
    "WebAuthnChallengeMinutes": 5, //challenge 有效期（分钟）
    "WebAuthnMaxCredentials": 10 //每个账号最多绑定的 Passkey 数
  },
  // 商城业务参数，详见《商城文档》
  "MallSettings": {
    "AutoConfirmReceiptDays": 7, //发货后自动确认收货天数；非法值按 7
    "AfterSaleDays": 15, //确认收货后可申请售后天数，0=不限
    "AllowMockPay": false, //模拟支付，仅联调开启，生产必须 false
    "ClosePendingMinutes": 30, //未支付订单超时关单分钟数
    "ClosePendingBatchSize": 500, //超时关单每轮处理上限（最大 1000）
    "WaitDeliveryExportLimit": 50000 //待发货导出行数上限
  },
  // 多租户配置，详见《SaaS 多租户》
  "TenantSettings": {
    "UseTenant": 0, //0:不启用 1/true/on:启用（两宿主须一致）
    "RootDomains": [ "zradmin.net" ], //租户根域名，按子域解析时据此剥离
    "ReservedSubDomains": [ "www", "admin", "api", "doc" ], //保留子域，不解析为租户
    "PlatformMenuPermPrefixes": [ //平台专属权限前缀，非主租户不可访问
      "system:menu:",
      "system:tenant:",
      "system:tenantplanmenu:",
      "monitor:job:",
      "monitor:online:",
      "system:lang:",
      "monitor:server",
      "monitor:cache",
      "system:datascreen:list",
      "emaillog",
      "tool:gen"
    ]
  },
  "Quartz": {
    "quartz.serializer.type": "newtonsoft" //binary 依赖的 BinaryFormatter 已被 .NET 9+ 移除；持久化时再加 jobStore.*
  },
  // 定时任务执行策略（全局）：默认不限制/不重试/不通知，按需开启
  "QuartzTask": {
    "Enabled": false, //任务总开关；关闭时不启动调度器（多实例去重需 Redis）
    "TimeoutSeconds": 0, //单任务超时（秒），0=不限；超时结果标记未知且不重试
    "MaxRetryCount": 0, //失败重试次数（不含首次）
    "RetryIntervalSeconds": 10, //重试间隔（秒）
    "NotifyOnFailure": false, //失败通知总开关
    "NotifyChannels": [ "wx", "email" ], //通知渠道：wx=企业微信，email=邮件
    "NotifyCooldownMinutes": 30, //同「任务+租户」通知冷却（分钟），0=不限
    "NotifyEmails": "" //邮件收件人，逗号或分号分隔；空=不发邮件
  },
  "ShowDbLog": false, //是否打印db日志
  // 模块初始化开关：--initdb 时生效，与运行期开关（UseTenant、AiOptions.Enable）相互独立
  "ModuleInit": {
    "Saas": false, //初始化 SaaS 平台菜单/权限（无独立建表）
    "Member": false, //初始化会员表 ums_member（与商城同库）
    "Mall": false, //初始化商城（建表 + 定时任务 + 菜单）
    "Workflow": false, //初始化工作流（建表 + 定时任务 + 菜单）
    "Pro": false
  },
  "DbMigration": {
    "ReportOnly": false, //true=仅输出差异报告，不执行 DDL
    "AdditionalTypes": [] //需额外迁移的自定义实体，格式 "类型全名, 程序集名"
  },
  "DemoMode": false, //是否演示模式
  "SingleLogin": false, //true=单设备登录（新登录挤掉旧会话），跨节点需 Redis
  "workId": 1, //雪花id机器号，两宿主必须不同
  "sqlExecutionTime": 5, //Sql执行超过多少秒记录日志并告警
  "Upload": {
    "uploadUrl": "http://localhost:8888", //本地存储访问前缀；反代带路径前缀时须带上且以 / 结尾
    "localSavePath": "", //本地上传目录，空=wwwroot（Docker 下默认 uploads）
    "maxSize": 15, //单文件上限（MB），超过直接拒绝（请求体总上限仍由 requestLimitSize 控制）
    "allowedExt": [], //允许上传的扩展名白名单（含点，如 ".png"），不区分大小写；留空=不启用，只走 notAllowedExt 黑名单
    "checkFileSignature": true, //校验文件头（魔数）与扩展名是否一致，拦截「HTML 改名 .png」这类绕过
    "notAllowedExt": [ ".bat", ".exe", ".jar", ".js", ".html", ".htm", ".xhtml", ".svg" ], //禁止上传的扩展名（svg/html 可执行脚本，避免存储型 XSS）
    "requestLimitSize": 50, //请求体大小上限（MB），缺失会限制所有请求
    "defaultStoreType": "Local" //未指定 storeType 时使用：Local/ALIYUN/S3
  },
  //阿里云存储（上传/删除均未真正实现，实际请用 S3）
  "ALIYUN_OSS": {
    "REGIONID": "", //eg：cn-hangzhou
    "KEY": "XX",
    "SECRET": "XX",
    "bucketName": "bucketName",
    "domainUrl": "http://xxx.xxx.com", //访问资源域名
    "maxSize": 100 //单文件大小上限（MB）
  },
  "OssProvider": "s3", //默认存储实现（缺省 Aliyun）
  // S3 兼容对象存储（RustFS / MinIO / Ceph RGW / Cloudflare R2 / AWS S3 等）
  // 联调时务必把对象下载回来比对字节，不要只看上传返回 200
  "S3": {
    "displayName": "RustFS", //展示/日志用名称
    "endpoint": "http://127.0.0.1:9000", //服务端点
    "accessKey": "",
    "secretKey": "",
    "bucketName": "",
    "domainUrl": "", //公开访问前缀，自建直连必须带桶名（http://ip:8000/zradmin）；留空=相对路径
    "forcePathStyle": true, //自建 S3 必须 true，否则按 Virtual-host 拼成 bucket.ip:port
    "region": "us-east-1", //SDK 签名必填，自建服务通常忽略
    "maxSize": 100, //单文件大小上限（MB）
    "cacheControl": "public, max-age=2592000" //对象缓存头，留空则不缓存
  },
  //企业微信通知配置
  "WxCorp": {
    "AgentID": "",
    "CorpID": "",
    "CorpSecret": "",
    "SendUser": "@all"
  },
  //微信公众号设置
  "WxOpen": {
    "AppID": "",
    "AppSecret": ""
  },
  //短信服务（Enabled=false 为模拟发送，只记日志；对接服务商后设为 true）
  "SmsOptions": {
    "Enabled": false,
    "Provider": "None", //None/Aliyun/TencentCloud，对接时在 DefaultSmsSender 对应分支实现
    "AccessKeyId": "", //阿里云 AccessKeyId / 腾讯云 SecretId
    "AccessKeySecret": "", //阿里云 AccessKeySecret / 腾讯云 SecretKey
    "SignName": "", //短信签名
    "Endpoint": "", //阿里云 dysmsapi.aliyuncs.com / 腾讯云地域 ap-guangzhou
    "SdkAppId": "", //腾讯云 SdkAppId
    "Templates": { //业务场景->模板编号映射（可选）
      //"login": "SMS_10001",
      //"register": "SMS_10002"
    }
  },
  //邮箱配置（数组可配多个发件人，详见《邮件发送》）
  "MailOptions": [
    {
      "FromName": "system", //发件人名称，数组内唯一
      "FromEmail": "", //eg：xxxx@qq.com
      "Password": "", //邮箱密码/授权码，建议环境变量注入
      "Smtp": "smtp.qq.com",
      "Port": 587,
      "Signature": "系统邮件，请勿回复！",
      "UseSsl": true,
      "Enabled": true, //false=模拟发送（只写记录不投递）
      "Security": "", //Auto/StartTls/StartTlsWhenAvailable/SslOnConnect/None；空=按 UseSsl 映射
      "TimeoutSeconds": 30, //连接/读写超时（秒）
      "IgnoreCertificateErrors": false, //仅内网自签证书时开启
      "MaxAttachmentMB": 20, //单封附件总大小上限（MB）
      "MaxRetryCount": 3 //失败重试次数（不含首次）
    }
  ],
  //redis服务配置
  "RedisServer": {
    "open": 0, //是否启用redis
    "dbCache": false, //数据库是否使用Redis缓存，如果启用open要为1
    "Cache": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=cache:",
    "Session": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=session:"
  },
  //工作流配置
  "Workflow": {
    "Notify": { //通知渠道：站内信始终发送，邮件/短信只对"行动类"通知额外分发（待办/催办/转办/委托/加签/改派）
      "EmailEnabled": false, //邮件开关（需先配置上方 MailOptions 发件邮箱）
      "SmsEnabled": false, //短信开关（真实发送还需 SmsOptions.Enabled=true 并在 Templates 配置 workflow 模板）
      "MailFromName": "system" //使用 MailOptions 数组中哪个发件人配置
    }
  },
  //验证码配置
  "CaptchaOptions": {
    "IgnoreCase": true // 比较时是否忽略大小写
  },
  // 第三方登录（OAuth2）：字段、默认值（StateMinutes=10、AutoCreate=0、FrontendCallbackPath=/sociallogin）见《第三方授权登录》
  "OAuth": {
    "Enabled": false,
    // 渠道应用：Key 为渠道标识，多租户用 "渠道@租户" 覆盖
    "Clients": {
      "WECHAT_MINI": {
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  }
}
