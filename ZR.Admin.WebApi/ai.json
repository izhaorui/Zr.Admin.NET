{
  // AI 公共默认。密钥写在各 Provider 的 ApiKey；本地用同结构的 ai.Development.json 覆盖。
  // TimeoutSeconds：非流式=整请求总时长；流式=空闲超时（连续多久没收到数据才失败）。
  // MaxStreamDurationSeconds：流式整段输出的硬上限，防慢速滴流长期占用连接与在途额度；0=不限制。
  "AiOptions": {
    "Enable": true,
    "Provider": "qwen",
    "Temperature": 0.7,
    "MaxTokens": 4096,
    "TimeoutSeconds": 60,
    "MaxStreamDurationSeconds": 600,
    "EnableThinking": false,
    "EnableRetry": true,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 500,
    "MaxRetryDelayMs": 30000,
    "DefaultUserTotalTokens": 2000000,
    "ChatRateLimitPerMinute": 20,
    "PromptDir": "",
    "Providers": [
      {
        "Provider": "qwen",
        "Label": "通义千问",
        "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "ChatEndpoint": "/chat/completions",
        "ApiKey": "",
        "Model": "qwen3.7-plus",
        "VisionModel": "qwen3.7-flash",
        "Models": [
          "qwen-turbo",
          "qwen-plus",
          "qwen-max",
          "qwen3.7-plus",
          "qwen3.7-flash",
          "qwen3-vl-flash",
          "qwen3-vl-plus",
          "qwen-vl-plus"
        ]
      }
    ],
    "AttachmentDownloadAllowedHosts": []
  },
  // 外部知识库插件（ZR.AiKnowledge，可选模块）：只做检索 + 引用，文档解析/切片/向量化交给外部知识库。
  // Enable=false（默认）：search_knowledge 工具不下发模型、前端清单不出现、不发任何外部请求。
  // Provider：generic=自建 HTTP 检索接口；dify=Dify 数据集检索。新增渠道实现 IKnowledgeProvider 即可。
  // 改 Enable 后从下一个请求生效（工具清单按请求装配，本文件已 reloadOnChange）。
  "AiKnowledge": {
    "Enable": false,
    "Provider": "generic",
    // generic 填完整检索 URL；dify 填 API 根地址（如 https://api.dify.ai/v1）
    "Endpoint": "",
    "ApiKey": "",
    // 仅 Provider=dify 需要
    "DatasetId": "",
    // 知识库标识（generic 原样透传，可留空）
    "KbId": "",
    // 回灌给模型时展示的"来源"名称
    "KbName": "知识库",
    "TopK": 5,
    // 相似度下限（0-1，0=不启用）
    "MinScore": 0,
    "TimeoutSeconds": 15,
    // 单个片段回灌给模型的最大字符数（200-4000）
    "MaxContentChars": 800,
    // 可选权限码：非空时仅拥有该权限（或管理员）的用户能看到并调用该工具
    "Permission": ""
  }
}
