{
  // AI 公共默认。密钥写在各 Provider 的 ApiKey；本地用同结构的 ai.Development.json 覆盖。
  // TimeoutSeconds：非流式=整请求总时长；流式=空闲超时（连续多久没收到数据才失败）。
  // MaxStreamDurationSeconds：流式整段输出的硬上限，防慢速滴流长期占用连接与在途额度；0=不限制。
  "AiOptions": {
    "Enable": true,
    "Provider": "qwen",
    "Temperature": 0.7,
    "MaxTokens": 4096,
    "TimeoutSeconds": 60,
    "MaxStreamDurationSeconds": 600,
    "EnableThinking": false,
    "EnableRetry": true,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 500,
    "MaxRetryDelayMs": 30000,
    "DefaultUserTotalTokens": 2000000,
    "ChatRateLimitPerMinute": 20,
    "PromptDir": "",
    "Providers": [
      {
        "Provider": "qwen",
        "Label": "通义千问",
        "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "ChatEndpoint": "/chat/completions",
        "ApiKey": "",
        "Model": "qwen3.7-plus",
        "VisionModel": "qwen3.7-flash",
        "Models": [
          "qwen-turbo",
          "qwen-plus",
          "qwen-max",
          "qwen3.7-plus",
          "qwen3.7-flash",
          "qwen3-vl-flash",
          "qwen3-vl-plus",
          "qwen-vl-plus"
        ]
      }
    ],
    "AttachmentDownloadAllowedHosts": []
  }
}
