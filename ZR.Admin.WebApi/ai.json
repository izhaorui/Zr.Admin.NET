{
  // AI 公共默认。只写"与 AiOptions 默认值不同"或"需要运维常调"的项，其余走 C# 默认值。
  // 权威来源：db / auto(Production) 下全局参数以 ai_config 为准、渠道以 ai_provider 为准，本文件只作首次种子与库不可用时的兜底。
  // 实际生效来源可查 GET /aiGovernance/config/effective；启动日志在 Enable=true 时打印「AI 配置启动自检」，Enable=false 时跳过。
  // 字段含义、数据源策略（文件 vs 数据库）、ai_provider 渠道、顶层覆盖顺序、生效延迟、知识库配置：
  // 官方文档「后端 → AI 功能 → 4.2 配置文件与生效优先级」 https://www.izhaorui.cn/doc/backend/ai.html
  "AiOptions": {
    "Enable": true,
    "Provider": "qwen",
    "MaxTokens": 4096,
    "TimeoutSeconds": 60,
    "MaxStreamDurationSeconds": 600,
    "DefaultUserTotalTokens": 2000000,
    "ChatRateLimitPerMinute": 20,
    // 附件域名白名单（SSRF / 内网信息泄露防护）：不配置=不限制，显式空数组同样是不限制。
    // 生产建议按实际附件域名填上："AttachmentDownloadAllowedHosts": ["upload.example.com"]
    // 渠道真相在 ai_provider 表：启用数据库配置后本段被整份替换，线上请到后台「AI 治理 → 模型渠道」维护。
    "Providers": [
      {
        "Provider": "qwen",
        "Label": "通义千问",
        "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "ChatEndpoint": "/chat/completions",
        "ApiKey": "",
        "Model": "qwen3.7-plus",
        // 看图模型：须是该渠道支持多模态的模型（如 qwen3-vl-plus / qwen3-vl-flash），填错表现为看图被拒或忽略图片。
        "VisionModel": "qwen3-vl-plus",
        "Models": [
          "qwen-turbo",
          "qwen-plus",
          "qwen-max",
          "qwen3.7-plus",
          "qwen3.7-flash",
          "qwen3-vl-flash",
          "qwen3-vl-plus",
          "qwen-vl-plus"
        ]
      }
    ]
  },

  // 数据源策略：auto（默认，Production 读库 / 其它环境读文件）、db（以库为准，读不到即失败关闭）、file（只读本文件）。
  // 后台入口 GET/POST/DELETE aiGovernance/config；ai_config 为 60 秒进程内缓存，多实例最长 60 秒收敛。
  "AiConfig": {
    "Source": "auto"
  },

  // 外部知识库插件（可选）：Enable=false 时工具不下发、不发任何外部请求。
  // 与 AiOptions 同一数据源策略，后台保存过则以库为准；字段说明见 ZR.AiKnowledge/AiKnowledgeOptions.cs。
  // 知识库只在 KnowledgeBases 里声明，每项自带连接信息，不做顶层回落：
  //   Provider：generic=自建 HTTP 检索接口（Endpoint 填完整检索 URL）；dify=Dify 数据集检索（Endpoint 填 API 根地址，另需 DatasetId + ApiKey）。
  //   Id 是模型与前端选库的唯一标识（留空自动补 kb1/kb2…，生产建议显式填写）。
  //   IsDefault=true 的库作为模型未指定 kbId 时的默认库，都未标记则取第一项；Enabled=false 可下线某个库。
  //   TopK / MinScore / TimeoutSeconds 可省略（默认 5 / 0 / 15）；Permission 为空表示该库不做库级限制（工具级权限见顶层 Permission）。
  // 启用后 search_knowledge 多一个 kbId 参数（取值=库的 Id），审计可按库统计：GET ai/knowledge/query/stat → byBase。
  "AiKnowledge": {
    "Enable": false,
    "KnowledgeBases": [
      // { "Id": "hr", "Name": "人事库", "Provider": "generic", "Endpoint": "https://kb-hr.example.com/api/search", "Description": "考勤、假期、员工手册" },
      // { "Id": "fin", "Name": "财务库", "Provider": "dify", "Endpoint": "https://api.dify.ai/v1", "DatasetId": "", "ApiKey": "", "IsDefault": true, "Permission": "ai:kb:fin" }
    ]
  }
}
