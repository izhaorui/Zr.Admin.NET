{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "LogLevel": {
        "Microsoft.*": "None"
      }
    }
  },
  // 须与内网宿主指向同一套库；商城库由顶层键 MallDb 指定 ConfigId（未配置则回退 "0"）。
  // 本文件随代码入库，账号密码用未入库的 appsettings.{Environment}.json 或环境变量 dbConfigs__0__Conn 覆盖
  "dbConfigs": [
    {
      "Conn": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ZrAdmin_test;Encrypt=True;TrustServerCertificate=True;Integrated Security=True;",
      "DbType": 1, //数据库类型 MySql = 0, SqlServer = 1, Oracle = 3，PgSql = 4
      "ConfigId": "0", //多租户唯一标识（主库）
      "IsAutoCloseConnection": true
    },
    {
      "Conn": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ZrAdmin_test;Encrypt=True;TrustServerCertificate=True;Integrated Security=True;",
      "DbType": 1,
      "ConfigId": "1", //商城数据库
      "IsAutoCloseConnection": true
    }
    //...下面添加更多的数据库源（SaaS 租户库）
  ],
  "urls": "http://localhost:8889", //公网宿主端口，与内网宿主(8888)区分
  // 密钥环加密证书：留空时 Windows 用 DPAPI、Linux 明文落盘并告警；与内网宿主互相独立，可共用同一张证书
  "DataProtection": {
    "CertificatePath": "", //含私钥的 PFX 路径（绝对路径或相对内容根目录）
    "CertificatePassword": "" //PFX 口令，建议改用环境变量 DataProtection__CertificatePassword
  },
  // 微信支付V3：商城下单与回调在本宿主，租户续费在内网宿主；两者须同一商户号
  "WechatPay": {
    "Enabled": false,
    "MerchantId": "", //商户号 mchid
    "AppId": "", //绑定的公众号/应用 AppId
    "MerchantCertificateSerialNumber": "", //商户API证书序列号
    "MerchantCertificatePrivateKey": "", //商户API私钥（PEM 内容，含 BEGIN PRIVATE KEY）
    "MerchantV3Key": "", //APIv3 密钥（回调解密）
    "WechatPayPublicKeyId": "", //微信支付公钥ID（PUB_KEY_ID_xxx）
    "WechatPayPublicKey": "", //微信支付公钥（PEM，回调验签）
    "MiniProgramAppId": "", //微信小程序 AppId（与 H5 AppId 不同）
    "MiniProgramSecret": "", //微信小程序 Secret（用于 code 换 OpenId）
    "NotifyUrl": "https://your-front-domain.com/shopping/front/order/wechat/notify", //支付结果回调（公网HTTPS，必须指向本宿主）
    "H5ReturnUrl": "https://your-front-domain.com" //H5 场景 Wap 站点地址（商城 H5 支付回跳，指向公网域名）
  },
  // 模拟支付开关：WechatPay:Enabled=false 时必须显式开启才放行；生产保持 false
  "MallSettings": {
    "AllowMockPay": false
  },
  "corsUrls": [ "http://localhost:8886" ], //跨域地址（C 端 H5 站点域名），多个用","隔开
  // 本宿主不注册后台鉴权（无 JwtSettings）；会员令牌由本宿主唯一签发/校验，
  // SecretKey 须 ≥32 字节且不入库，未配置时拒绝签发并拒绝识别会员身份
  "MemberJwt": {
    "Issuer": "ZRAdmin.Member", //C端会员令牌签发者（与后台隔离）
    "Audience": "ZRAdmin.Member.App", //会员令牌使用方（后期独立商城App）
    "Expire": 20160, //会员令牌过期时间（分），默认14天
    "SecretKey": ""
  },
  // 多租户：SaaS 下匿名 C 端请求靠这里按域名定位租户库，不可删除
  "TenantSettings": {
    "UseTenant": 0, //0:不启用 1/true/on:启用（须与内网宿主一致）
    "RootDomains": [ "zradmin.net" ], //租户根域名，按子域解析时据此剥离
    "ReservedSubDomains": [ "www", "admin", "api", "doc", "shop", "front" ] //保留子域；商城域名必须列入
  },
  "ShowDbLog": false, //是否打印db日志
  // ⚠️ 雪花ID工作号：必须与内网宿主不同，否则两个宿主会生成重复 ID
  "workId": 2,
  "sqlExecutionTime": 5, //Sql执行时间超过多少秒记录日志并警报
  // 上传与请求体限制（本宿主暂不暴露上传接口，保持与内网宿主同口径）
  "Upload": {
    "uploadUrl": "https://your-front-domain.com", //本地存储访问前缀
    "localSavePath": "",
    "maxSize": 15, //单文件上限（MB），超过直接拒绝（请求体总上限仍由 requestLimitSize 控制）
    "allowedExt": [], //允许上传的扩展名白名单（含点，如 ".png"），不区分大小写；留空=不启用，只走 notAllowedExt 黑名单
    "checkFileSignature": true, //校验文件头（魔数）与扩展名是否一致，拦截「HTML 改名 .png」这类绕过
    "notAllowedExt": [ ".bat", ".exe", ".jar", ".js", ".html", ".htm", ".xhtml", ".svg" ],
    "requestLimitSize": 50, //请求体上限（MB），缺失会限制所有请求
    "defaultStoreType": "Local" //Local/ALIYUN/S3
  },
  // 阿里云存储（上传实现未完成，仅占位）
  "ALIYUN_OSS": {
    "REGIONID": "",
    "KEY": "",
    "SECRET": "",
    "bucketName": "",
    "domainUrl": "",
    "maxSize": 100
  },
  // S3 兼容存储：保留给后续 C 端上传（评价晒图/头像）复用
  "S3": {
    "displayName": "RustFS",
    "endpoint": "",
    "accessKey": "",
    "secretKey": "",
    "bucketName": "",
    "domainUrl": "", //自建直连必须带桶名（http://ip:8000/zradmin）；留空=相对路径
    "forcePathStyle": true, //自建 S3 必须 true
    "region": "us-east-1",
    "maxSize": 100,
    "cacheControl": "public, max-age=2592000" //对象缓存头，留空则不缓存
  },
  //短信服务配置（与内网宿主一致；发码链路用到）
  "SmsOptions": {
    "Enabled": false,
    "Provider": "None", //None/Aliyun/TencentCloud，对接时在 DefaultSmsSender 对应分支实现
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "SignName": "",
    "Endpoint": "",
    "SdkAppId": "",
    "Templates": {
      //"login": "SMS_10001",
      //"register": "SMS_10002"
    }
  },
  // 开发联调：true 时验证码接口返回 devCode；生产必须 false
  "MockSms": {
    "Enabled": false
  },
  //redis服务配置（与内网宿主一致）
  "RedisServer": {
    "open": 0, //是否启用redis
    "dbCache": false, //数据库是否使用Redis缓存，如果启用open要为1
    "Cache": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=cache:",
    "Session": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=session:"
  }
}
