{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "LogLevel": {
        "Microsoft.*": "None"
      }
    }
  },
  // ⚠️ 必须与内网宿主 ZR.Admin.WebApi 指向同一套数据库
  "dbConfigs": [
    {
      "Conn": "Data Source=(localdb)\\MSSQLLocalDB;User ID=admin;Password=admin123;Initial Catalog=ZrAdmin_test;Encrypt=True;TrustServerCertificate=True;",
      "DbType": 1, //数据库类型 MySql = 0, SqlServer = 1, Oracle = 3，PgSql = 4
      "ConfigId": "0", //多租户唯一标识（主库）
      "IsAutoCloseConnection": true
    },
    {
      "Conn": "Data Source=(localdb)\\MSSQLLocalDB;User ID=admin;Password=admin123;Initial Catalog=ZrAdmin_test;Encrypt=True;TrustServerCertificate=True;",
      "DbType": 1,
      "ConfigId": "1", //商城数据库
      "IsAutoCloseConnection": true
    }
    //...下面添加更多的数据库源（SaaS 租户库）
  ],
  "urls": "http://localhost:8889", //公网宿主端口，与内网宿主(8888)区分
  // DataProtection 密钥环加密。留空时：Windows 回退 DPAPI，Linux/Docker 保持明文落盘并启动告警。
  // 两个宿主的密钥环互相独立（各自目录），可共用同一张证书；证书丢失会导致旧密钥无法解密，请与 DataProtection 目录一并备份。
  "DataProtection": {
    "CertificatePath": "", //含私钥的 PFX 路径（绝对路径或相对内容根目录）
    "CertificatePassword": "" //PFX 口令，建议改用环境变量 DataProtection__CertificatePassword
  },
  //微信支付V3（平台统一商户号）。与内网宿主共用同一商户号配置：
  //公网宿主负责商城下单与支付回调；内网宿主负责租户续费下单（H5 通道已停用，见部署说明）。
  "WechatPay": {
    "Enabled": false,
    "MerchantId": "", //商户号 mchid
    "AppId": "", //绑定的公众号/应用 AppId
    "MerchantCertificateSerialNumber": "", //商户API证书序列号
    "MerchantCertificatePrivateKey": "", //商户API私钥（PEM 内容，含 BEGIN PRIVATE KEY）
    "MerchantV3Key": "", //APIv3 密钥（回调解密）
    "WechatPayPublicKeyId": "", //微信支付公钥ID（PUB_KEY_ID_xxx）
    "WechatPayPublicKey": "", //微信支付公钥（PEM，回调验签）
    "MiniProgramAppId": "", //微信小程序 AppId（与 H5 AppId 不同）
    "MiniProgramSecret": "", //微信小程序 Secret（用于 code 换 OpenId）
    "NotifyUrl": "https://your-front-domain.com/shopping/front/order/wechat/notify", //支付结果回调（公网HTTPS，必须指向本宿主）
    "H5ReturnUrl": "https://your-front-domain.com" //H5 场景 Wap 站点地址（商城 H5 支付回跳，指向公网域名）
  },
  // 商城参数：模拟支付开关。WechatPay:Enabled=false 时，会员支付走模拟通道，必须显式开启此项才放行。
  // 默认 false（生产安全）；本地联调请用环境变量 MallSettings__AllowMockPay=true 或本机 Development 覆盖，勿提交为 true。
  "MallSettings": {
    "AllowMockPay": false
  },
  "corsUrls": [ "http://localhost:8886" ], //跨域地址（C 端 H5 站点域名），多个用","隔开
  // 本宿主不注册后台鉴权管线（AddJwt / UseAuthentication / JwtAuthMiddleware 均已移除），
  // 因此不再需要 JwtSettings 配置块。共享工具类 JwtUtil 已支持优雅降级：
  //   TryGetValidParameters() 未配置时返回 null，ParseToken() 视为"没有有效的后台令牌"直接返回 null，
  //   请求即便误带 Authorization 头也不会再抛异常。宿主不持有后台签名密钥，也就无法校验或伪造后台令牌。
  // ⚠️ 会员令牌密钥：仅本宿主使用（内网宿主已不再注册 [PublicApi] 的 C 端接口，无需该配置）。
  //    本宿主是会员令牌的唯一签发与校验方，必须显式配置：
  //    未配置时拒绝签发、并拒绝识别会员身份（不会再退化为从其他密钥派生）。
  // ⚠️ SecretKey 用于签发 C 端会员令牌，禁止明文提交（本文件会提交到仓库），默认为空。
  //    注入方式：appsettings.Development.json / appsettings.Production.json（均已被 gitignore）/ 环境变量 MemberJwt__SecretKey。
  "MemberJwt": {
    "Issuer": "ZRAdmin.Member", //C端会员令牌签发者（与后台隔离）
    "Audience": "ZRAdmin.Member.App", //会员令牌使用方（后期独立商城App）
    "Expire": 20160, //会员令牌过期时间（分），默认14天
    "SecretKey": ""
  },
  // 多租户配置：SaaS 部署下匿名 C 端请求正是靠这里按域名定位租户库，不可删除。
  // （PlatformMenuPermPrefixes 是后台权限前缀，公网宿主无后台端点，已省略）
  "TenantSettings": {
    //是否启用多租户 0:不启用 1/true/on:启用（必须与内网宿主一致）
    "UseTenant": 0,
    // 租户根域名（按子域名解析租户时据此剥离子域标签，如 a.zradmin.net → a）。按实际部署域名配置，本地 localhost 不受影响。
    "RootDomains": [ "zradmin.net" ],
    // 保留子域名：这些子域名不解析为租户。公网商城域名/子域必须列入（如 shop、front），否则会被误判为租户。
    "ReservedSubDomains": [ "www", "admin", "api", "doc", "shop", "front" ]
  },
  "ShowDbLog": false, //是否打印db日志
  // ⚠️ 雪花ID工作号：必须与内网宿主不同，否则两个宿主会生成重复 ID
  "workId": 2,
  "sqlExecutionTime": 5, //Sql执行时间超过多少秒记录日志并警报
  // 请求体大小限制（AddRequestLimit 读取 upload:requestLimitSize，缺失会限制所有请求体）
  "Upload": {
    "uploadUrl": "https://your-front-domain.com", //本地存储资源访问路径（公网宿主不处理上传，仅保持配置口径一致）
    "localSavePath": "",
    "maxSize": 15,
    "notAllowedExt": [ ".bat", ".exe", ".jar", ".js" ],
    "requestLimitSize": 50, //请求body大小限制
    // 默认存储类型：Local / ALIYUN / S3（与内网宿主保持一致；本宿主当前不暴露上传接口）
    "defaultStoreType": "Local"
  },
  // 阿里云存储配置：本宿主不处理上传，但 IOssProvider 注册时会构造 AliyunOssProvider 并读取该节点，
  // 缺失会让其内部配置对象为 null —— 补空节点消除该隐患（上传逻辑仍未实现）。
  "ALIYUN_OSS": {
    "REGIONID": "",
    "KEY": "",
    "SECRET": "",
    "bucketName": "",
    "domainUrl": "",
    "maxSize": 100
  },
  // S3 兼容对象存储配置（与内网宿主口径一致）。本宿主当前不暴露上传接口，
  // 保留是为将来 C 端上传接口（评价晒图/头像）复用同一套配置与 Provider。
  "S3": {
    "displayName": "RustFS",
    "endpoint": "",
    "accessKey": "",
    "secretKey": "",
    "bucketName": "",
    // AccessUrl = domainUrl + 对象键（不自动补桶名）；自建直连必须带桶名，如 http://122.0.0.1:8000/zradmin，
    // 否则对象键被当成根路径、打开返回 AccessDenied。走反代/CDN 且已隐去桶名时填去掉桶名的地址。
    "domainUrl": "",
    "forcePathStyle": true, //自建 S3 必须 true，否则 Virtual-host 寻址失败
    "region": "us-east-1",
    "maxSize": 100,
    "cacheControl": "public, max-age=2592000" //对象缓存头：省流量的关键一项，说明见内网宿主同名配置
  },
  //短信服务配置（与内网宿主一致；发码链路用到）
  "SmsOptions": {
    "Enabled": false,
    "Provider": "None", //None/Aliyun/TencentCloud，对接时在 DefaultSmsSender 对应分支实现
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "SignName": "",
    "Endpoint": "",
    "SdkAppId": "",
    "Templates": {
      //"login": "SMS_10001",
      //"register": "SMS_10002"
    }
  },
  // 开发联调：true 时验证码接口返回 devCode；生产必须 false
  "MockSms": {
    "Enabled": false
  },
  //redis服务配置（与内网宿主一致）
  "RedisServer": {
    "open": 0, //是否启用redis
    "dbCache": false, //数据库是否使用Redis缓存，如果启用open要为1
    "Cache": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=cache:",
    "Session": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=session:"
  }
}
